{
  "rule": [
    {
      "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" },
      "condition": { "age": 90, "matchesPrefix": ["audio/"], "matchesStorageClass": ["STANDARD"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "age": 1096, "matchesPrefix": ["audio/"] }
    }
  ]
}
