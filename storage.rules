rules_version = '2';

// PlainSpeak Storage rules. See PLAN.md §3.
// Audio path: audio/{programId}/{uid}/{sessionId}/recording.{webm|m4a|mp4|ogg}
service firebase.storage {
  match /b/{bucket}/o {
    function hasClaims() {
      return request.auth != null
        && request.auth.token.role in ['resident', 'faculty']
        && request.auth.token.programId is string;
    }
    function isOwner(pid, uid) {
      return hasClaims() && request.auth.uid == uid && request.auth.token.programId == pid;
    }
    function facultyOf(pid) {
      return hasClaims() && request.auth.token.role == 'faculty'
        && request.auth.token.programId == pid;
    }
    match /audio/{pid}/{uid}/{sid}/{file} {
      allow read: if isOwner(pid, uid) || facultyOf(pid);

      // The owner uploads once, into their own folder only. We deliberately
      // avoid a cross-service firestore.get() here (unreliable in the
      // emulator, extra setup + a read per upload in production). Instead
      // endSession links audio only for the caller's own session, and the
      // retention job (Phase 7) sweeps uploads that were never linked.
      allow create: if isOwner(pid, uid)
        && resource == null
        && sid.matches('[A-Za-z0-9_-]{1,64}')
        && file.matches('recording\\.(webm|m4a|mp4|ogg)')
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      // Deletion only by the server (retention job).
      allow update, delete: if false;
    }

    // Face check (faculty test of a patient's video face): the recording and
    // its timing notes. Faculty upload into their own folder, once per file.
    match /faceChecks/{pid}/{uid}/{file} {
      allow read: if facultyOf(pid);
      allow create: if facultyOf(pid)
        && request.auth.uid == uid
        && resource == null
        && file.matches('[A-Za-z0-9_-]{1,64}\\.(webm|mp4|json)')
        && request.resource.size < 40 * 1024 * 1024
        && (request.resource.contentType.matches('video/.*')
          || request.resource.contentType == 'application/json');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
